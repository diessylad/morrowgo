# Copy to .env.local for development. Use your project's public credentials.
# Add the same names in Vercel and redeploy after changing NEXT_PUBLIC values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://www.morrowgo.com

# Legacy public anon keys are supported if no publishable key is configured.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put service-role keys, database passwords or SMTP passwords in NEXT_PUBLIC variables.
# Existing Stripe, Redis and fulfillment settings are managed separately.
